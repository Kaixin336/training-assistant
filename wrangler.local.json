{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kai-training",
  "main": "server/worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "kai-training-local", "database_id": "00000000-0000-4000-8000-000000000000", "migrations_dir": "drizzle" }],
  "vars": { "APP_ORIGIN": "http://127.0.0.1:5180", "DEEPSEEK_MODEL": "deepseek-flash" }
}
